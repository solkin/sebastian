# Copy to .env and fill in. Leaving BOTH keys of a gateway empty disables its
# auth (open/unauthenticated access) — set them for any real deployment.

# Published image to pull. Pin a version tag for reproducible deploys,
# e.g. solkin/sebastian:1.2.3 (the ":latest" tag moves on every release).
SEBASTIAN_IMAGE=solkin/sebastian:latest

# S3 gateway credentials (AWS Signature V4)
S3_ACCESS_KEY=changeme-access-key
S3_SECRET_KEY=changeme-secret-key

# HTTP UI credentials (basic auth)
HTTP_USERNAME=admin
HTTP_PASSWORD=changeme-password
