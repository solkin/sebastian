# Copy to .env and fill in. Sebastian refuses to start with an empty or half-set
# credential, and with any value that still starts with "changeme". Set
# SEBASTIAN_<GATEWAY>_ALLOW_ANONYMOUS=true only if open access is intended.

# Published image to pull. Pin a version tag for reproducible deploys
# (the ":latest" tag moves on every release).
SEBASTIAN_IMAGE=solkin/sebastian:1.7.0

# S3 gateway credentials (AWS Signature V4)
S3_ACCESS_KEY=changeme-access-key
S3_SECRET_KEY=changeme-secret-key

# HTTP UI credentials (basic auth)
HTTP_USERNAME=admin
HTTP_PASSWORD=changeme-password
